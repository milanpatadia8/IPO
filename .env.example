# Port configuration for local/cloud dev server
PORT=3000

# Supabase Credentials (optional for cloud persistence)
# The application includes a self-contained in-memory & mock persistence engine
# with complete PostgreSQL migrations and seed scripts for Supabase deployment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Secret for automated synchronization endpoints
CRON_SECRET=ipo_tracker_cron_secret_key_demo

# Exchange / Data Provider API credentials (Pluggable)
# When not provided, platform operates using verified local fixtures and public filings
NSE_API_KEY=
BSE_API_KEY=

# Freshness Thresholds (Hours)
DATA_FRESHNESS_HOURS_GMP=24
DATA_FRESHNESS_HOURS_SUBSCRIPTION=12
